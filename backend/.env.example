SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
TMDB_API_KEY=your-tmdb-api-key
# Gallery web image search uses DuckDuckGo + SearXNG — no keys required.
# Optional: PornhwaDB manhwa catalogue (copy pornhwa-export.json to backend/data/)
PORNHWADB_DATA_PATH=data/pornhwa-export.json
# Production: private Supabase bucket (see scripts/upload_pornhwadb_export.py)
PORNHWADB_STORAGE_BUCKET=otakuvault-private
PORNHWADB_STORAGE_OBJECT=pornhwa-export.json
# Or any HTTPS URL the API can GET on startup
PORNHWADB_DATA_URL=
NVIDIA_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_REGEX=
